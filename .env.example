# MongoDB connection string (use MongoDB Atlas free tier, or local mongodb://localhost:27017/parking-marketplace)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/parking-marketplace

# NextAuth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-this-with-a-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000

# Email of the account that should become admin when you run `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123

# --- Optional integrations (app runs fine without these; each feature just shows a
# graceful "not configured" state until you add real credentials) ---

# Image upload (Cloudinary) - https://cloudinary.com — free tier available.
# Without these, spot photos fall back to a plain "paste an image URL" field.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (Resend) - https://resend.com — used for booking/listing
# notification emails. Without this, in-app notifications still work; only email
# delivery is skipped (and never blocks the underlying action if it's missing).
RESEND_API_KEY=

# Real payments (Razorpay) - https://razorpay.com. Without these, "payment" in the
# booking flow stays in its current simulated/development mode (clearly labeled as
# such in the UI) — it never pretends a real charge succeeded.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Note: maps/location search use OpenStreetMap (Nominatim) + Leaflet, which need no
# API key or account, so there's nothing to configure for that feature.
